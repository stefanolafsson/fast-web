---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;

const funds = [
  {
    name: 'Private Sector Relief Fund — Sjúkrasjóður',
    url: 'https://www.bhm.is/en/styrkir-og-sjodir/sjukrasjodur',
    desc: 'Grants towards health and preventive care, fitness, glasses and hearing aids, as well as a childbirth grant, sickness benefits and a funeral grant.',
  },
  {
    name: 'Vacation Fund — Orlofssjóður',
    url: 'https://www.bhm.is/en/styrkir-og-sjodir/orlofssjodur',
    desc: 'Holiday cottages and apartments to rent across Iceland, along with gift certificates, gift cards and a range of member discounts.',
  },
  {
    name: 'Vocational Education Fund — Starfsmenntunarsjóður',
    url: 'https://www.bhm.is/en/styrkir-og-sjodir/starfsmenntunarsjodur',
    desc: 'Grants for continuing education and training, such as courses, conferences and study trips related to members’ work.',
  },
];
---

<Layout title="Rights & Terms" description="BHM funds, collective agreements and the rights of FAST members." pageKey="pay">
  <div class="page-header">
    <div class="container">
      <h1>Rights &amp; Terms</h1>
      <p>Information about BHM funds, collective agreements, rights and the terms of employment of academic staff.</p>
    </div>
  </div>

  <div class="page-content">
    <div class="container">
      <div class="prose">
        <h2>BHM funds</h2>
        <p>
          FAST members belong to BHM's funds and can apply for grants from them.
          Applications and details of your entitlement status are available on
          <a href="https://minarsidur.bhm.is" target="_blank" rel="noopener">Mínar síður</a>, the BHM member portal.
        </p>
      </div>

      <div class="funds-grid">
        {funds.map((fund) => (
          <a class="fund-card" href={fund.url} target="_blank" rel="noopener">
            <h3 class="card-title">{fund.name}</h3>
            <p class="card-text">{fund.desc}</p>
            <span class="fund-link">More on the BHM website &rarr;</span>
          </a>
        ))}
      </div>

      <div class="prose" style="margin-top: var(--space-16);">
        <h2>Collective agreements</h2>
        <p>
          FAST does not yet have a collective agreement in force with RU. The board is currently working to secure a collective agreement for members. Read more in this <a href={`${base}en/news/kjarasamningar-stadan`}>news item</a>.
        </p>
        <p>
          The terms and rights of academic staff at RU will fall under the agreement being negotiated in cooperation with BHM. Collective agreements cover, among other things, pay, working hours, holiday entitlement, sick-pay rights and other terms of employment.
        </p>
      </div>

      <div class="rights-grid">
        <div class="card">
          <h3 class="card-title">Pay and pay scales</h3>
          <p class="card-text">
            The pay of academic staff is based on the salary tables in collective
            agreements. Pay levels take account of the role, education, length of
            service and other factors as set out in the agreements.
          </p>
        </div>
        <div class="card">
          <h3 class="card-title">Annual leave</h3>
          <p class="card-text">
            Members are entitled to annual leave under the <a href="https://www.althingi.is/lagas/nuna/1987030.html">Holiday Allowance Act</a>.
            Further information about holiday entitlements and access to holiday
            cottages through BHM is available on the <a href="https://orlof.bhm.is/">BHM holiday website</a>.
          </p>
        </div>
        <div class="card">
          <h3 class="card-title">Sick-leave rights</h3>
          <p class="card-text">
            The right to pay during illness is guaranteed by law. The length of
            sick-leave entitlement depends on length of service and the terms of the
            applicable employment contract.
          </p>
        </div>
        <div class="card">
          <h3 class="card-title">Pension fund</h3>
          <p class="card-text">
            A mandatory contribution is paid into a pension fund as required by law.
            Members are also entitled to an employer's matching contribution to a
            private (supplementary) pension fund.
          </p>
        </div>
        <div class="card">
          <h3 class="card-title">Professional development</h3>
          <p class="card-text">
            Members are entitled to leave and/or a grant for professional development,
            research and continuing education in accordance with the university's rules.
          </p>
        </div>
        <div class="card">
          <h3 class="card-title">Parental leave</h3>
          <p class="card-text">
            The right to parental leave is governed by the Act on Maternity/Paternity
            and Parental Leave. Collective agreements may grant rights beyond the
            statutory minimum.
          </p>
        </div>
      </div>

      <div class="prose" style="margin-top: var(--space-16);">
        <h2>Useful links</h2>
        <ul>
          <li><a href="https://www.bhm.is" target="_blank" rel="noopener">BHM — Confederation of University Graduates</a></li>
          <li><a href="https://island.is" target="_blank" rel="noopener">Ísland.is — Official services portal</a></li>
        </ul>
      </div>
    </div>
  </div>
</Layout>

<style>
  .rights-grid,
  .funds-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-top: var(--space-10);
  }

  .funds-grid {
    margin-top: var(--space-8);
  }

  .fund-card {
    display: block;
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
  }

  .fund-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--color-border);
    transform: translateY(-2px);
  }

  .fund-card .card-title {
    color: var(--color-primary);
  }

  .fund-card .card-text {
    margin-bottom: 0;
  }

  .fund-link {
    display: inline-block;
    margin-top: var(--space-4);
    color: var(--color-primary-light);
    font-weight: 600;
    font-size: var(--size-sm);
  }

  .fund-card:hover .fund-link {
    color: var(--color-primary);
  }

  @media (min-width: 640px) {
    .rights-grid,
    .funds-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .rights-grid,
    .funds-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
