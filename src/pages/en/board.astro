---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;

const boardMembers = [
  { name: 'Freyr Halldórsson', role: 'Chair', department: 'Department of Business and Economics', image: `${base}images/stjorn/freyr.png` },
  { name: 'Jens Arnljótsson', role: 'Treasurer', department: 'Department of Applied Engineering', image: `${base}images/stjorn/jens.png` },
  { name: 'Stefán Ólafsson', role: 'Board member', department: 'Department of Computer Science', image: `${base}images/stjorn/stefan.jpg` },
  { name: 'Hanna Steinunn Steingrímsdóttir', role: 'Board member', department: 'Department of Psychology', image: `${base}images/stjorn/hanna.png` },
  { name: 'Birna Valborgar Baldursdóttir', role: 'Board member', department: 'Department of Psychology', image: `${base}images/stjorn/birna.png` },
  { name: 'Arnljótur Ástvaldsson', role: 'Board member', department: 'Department of Law', image: `${base}images/stjorn/arnljotur.png` },
];
---

<Layout title="Board" description="The board of FAST — the Association of Academic Staff at RU." pageKey="board">
  <div class="page-header">
    <div class="container">
      <h1>The board</h1>
      <p>The board of FAST is elected at the association's annual general meeting and safeguards members' interests.</p>
    </div>
  </div>

  <div class="page-content">
    <div class="container">
      <div class="prose">
        <h2>Board members</h2>
        <p>
          The board of FAST is elected at the association's annual general meeting
          for two-year terms. The board meets regularly and handles the day-to-day
          running of the association.
        </p>
      </div>

      <div class="board-grid">
        {boardMembers.map((member) => (
          <div class="board-card">
            <div class="board-avatar">
              {member.image ? (
                <img src={member.image} alt={member.name} width="64" height="64" loading="lazy" />
              ) : (
                <span>{member.name.charAt(0)}</span>
              )}
            </div>
            <div class="board-info">
              <h3>{member.name}</h3>
              <p class="board-role">{member.role}</p>
              <p class="board-dept">{member.department}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="prose" style="margin-top: var(--space-16);">
        <h2>The board's role</h2>
        <p>The board of FAST has the following responsibilities:</p>
        <ul>
          <li>To manage the association's affairs between annual general meetings.</li>
          <li>To safeguard members' interests in pay and conditions.</li>
          <li>To liaise with RU's senior management on terms of employment and the working environment.</li>
          <li>To keep members informed about pay matters and other issues that concern them.</li>
          <li>To convene the annual general meeting and other meetings.</li>
        </ul>

        <h2>Annual general meeting</h2>
        <p>
          The association's annual general meeting is held each year, usually in the
          spring term. At the meeting the board is elected, the accounts are presented
          and the association's policy is decided. All members have the right to attend
          and vote at the annual general meeting.
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .board-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-top: var(--space-10);
  }

  .board-card {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    transition: all 0.2s ease;
  }

  .board-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .board-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }

  .board-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .board-avatar span {
    font-size: var(--size-2xl);
    font-weight: 700;
    color: var(--color-text-inverse);
  }

  .board-info h3 {
    font-size: var(--size-lg);
    color: var(--color-primary);
    margin-bottom: var(--space-1);
  }

  .board-role {
    font-weight: 600;
    color: var(--color-primary-light);
    font-size: var(--size-sm);
    margin-bottom: var(--space-1) !important;
  }

  .board-dept {
    color: var(--color-text-light);
    font-size: var(--size-sm);
  }

  @media (min-width: 640px) {
    .board-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .board-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
