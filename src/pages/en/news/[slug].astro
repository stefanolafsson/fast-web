---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { newsLang, newsSlug, newsUrl, localizedPath, useTranslations, dateLocale } from '../../../i18n/utils';

export async function getStaticPaths() {
  const all = await getCollection('frettir');
  const isSlugs = new Set(
    all.filter((e) => newsLang(e.id) === 'is').map((e) => newsSlug(e.id))
  );
  return all
    .filter((entry) => newsLang(entry.id) === 'en')
    .map((entry) => {
      const slug = newsSlug(entry.id);
      const altUrl = isSlugs.has(slug) ? newsUrl(slug, 'is') : localizedPath('news', 'is');
      return {
        params: { slug },
        props: { entry, altUrl },
      };
    });
}

const { entry, altUrl } = Astro.props;
const { Content } = await render(entry);
const t = useTranslations('en');
const newsHref = localizedPath('news', 'en');

function formatDate(date: Date): string {
  return date.toLocaleDateString(dateLocale.en, {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}
---

<Layout title={entry.data.title} description={entry.data.excerpt} lang="en" pageKey="news" altUrl={altUrl}>
  <div class="page-header">
    <div class="container">
      <a href={newsHref} class="back-link">{t('news.back')}</a>
      <h1>{entry.data.title}</h1>
      <div class="article-meta">
        <span class="tag">{entry.data.tag}</span>
        <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
      </div>
    </div>
  </div>

  <div class="page-content">
    <div class="container">
      <article class="prose">
        <Content />
      </article>
      <div class="article-footer">
        <a href={newsHref} class="btn btn-outline">{t('news.backToNews')}</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .back-link {
    display: inline-block;
    color: rgba(255, 255, 255, 0.8);
    font-size: var(--size-sm);
    font-weight: 500;
    margin-bottom: var(--space-6);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-text-inverse);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .article-meta .tag {
    background: rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.9);
  }

  .article-meta time {
    color: rgba(255, 255, 255, 0.8);
    font-size: var(--size-sm);
  }

  .article-footer {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border-light);
  }
</style>
