---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { newsLang, newsUrl, localizedPath, dateLocale } from '../../i18n/utils';

const latestNews = (await getCollection('frettir'))
  .filter((entry) => newsLang(entry.id) === 'en')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

const aboutHref = localizedPath('about', 'en');
const contactHref = localizedPath('contact', 'en');
const newsHref = localizedPath('news', 'en');
---

<Layout title="Home" pageKey="home">
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-content">
        <p class="hero-badge">A member union of BHM</p>
        <h1 class="hero-title">FAST</h1>
        <p class="hero-subtitle">Association of Academic Staff at Reykjavík University</p>
        <p class="hero-desc">
          We safeguard the rights and terms of academic staff at RU and work to
          improve their terms and working environment.
        </p>
        <div class="hero-actions">
          <a href={aboutHref} class="btn btn-primary">About</a>
          <a href={contactHref} class="btn btn-secondary">Contact</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">What does FAST do?</h2>
      <p class="section-subtitle">
        The association safeguards the interests of academic staff at Reykjavík University and works to improve their terms and working environment.
      </p>
      <div class="grid-3">
        <div class="card">
          <div class="card-icon">&#9878;</div>
          <h3 class="card-title">Collective agreements</h3>
          <p class="card-text">
            FAST works with BHM to negotiate collective agreements that secure
            fair terms and a good environment for academic staff at RU.
          </p>
        </div>
        <div class="card">
          <div class="card-icon">&#9733;</div>
          <h3 class="card-title">Advocacy</h3>
          <p class="card-text">
            The association protects members' rights in relation to the employer
            and ensures that collective agreements and the law are followed.
          </p>
        </div>
        <div class="card">
          <div class="card-icon">&#9825;</div>
          <h3 class="card-title">Working environment</h3>
          <p class="card-text">
            We place emphasis on a good working environment, good terms,
            equality and wellbeing at work for all members.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title">News</h2>
      <p class="section-subtitle">The latest news and announcements from FAST.</p>
      <div class="grid-2">
        {latestNews.map((item) => (
          <article class="news-card">
            <span class="tag">{item.data.tag}</span>
            <h3><a href={newsUrl(item.id, 'en')}>{item.data.title}</a></h3>
            <p>{item.data.excerpt}</p>
            <time datetime={item.data.date.toISOString()}>
              {item.data.date.toLocaleDateString(dateLocale.en, { month: 'long', year: 'numeric' })}
            </time>
          </article>
        ))}
      </div>
      <div class="news-more">
        <a href={newsHref} class="btn btn-outline">All news</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cta-box">
      <h2>A member union of BHM</h2>
      <p>
        FAST is a member union of <a href="https://www.bhm.is" target="_blank" rel="noopener">BHM — the Confederation of University Graduates</a>,
        an umbrella organisation of 27 trade unions of university-educated people in Iceland.
      </p>
      <a href="https://www.bhm.is" target="_blank" rel="noopener" class="btn btn-outline">Visit BHM</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 40%, var(--color-primary-light) 100%);
    padding: calc(var(--header-height) + var(--space-16)) 0 var(--space-20);
    position: relative;
    overflow: hidden;
    min-height: 520px;
    display: flex;
    align-items: center;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.03);
  }

  .hero::after {
    content: '';
    position: absolute;
    bottom: -30%;
    left: -10%;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.02);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 640px;
  }

  .hero-badge {
    display: inline-block;
    padding: var(--space-1) var(--space-4);
    background: rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.9);
    border-radius: 100px;
    font-size: var(--size-sm);
    font-weight: 500;
    margin-bottom: var(--space-6);
    backdrop-filter: blur(4px);
  }

  .hero-title {
    font-size: 4rem;
    font-weight: 800;
    color: var(--color-text-inverse);
    letter-spacing: -0.03em;
    margin-bottom: var(--space-2);
    line-height: 1;
  }

  .hero-subtitle {
    font-size: var(--size-xl);
    color: rgba(255, 255, 255, 0.9);
    font-weight: 500;
    margin-bottom: var(--space-6);
  }

  .hero-desc {
    color: rgba(255, 255, 255, 0.75);
    font-size: var(--size-lg);
    line-height: 1.7;
    margin-bottom: var(--space-8);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .card-icon {
    font-size: var(--size-3xl);
    margin-bottom: var(--space-4);
    color: var(--color-primary-light);
  }

  .news-card {
    padding: var(--space-8);
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-light);
    transition: all 0.2s ease;
  }

  .news-card:hover {
    box-shadow: var(--shadow-md);
  }

  .news-card .tag {
    margin-bottom: var(--space-4);
  }

  .news-card h3 {
    font-size: var(--size-xl);
    margin-bottom: var(--space-3);
    color: var(--color-primary);
  }

  .news-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .news-card h3 a:hover {
    color: var(--color-primary-light);
  }

  .news-card p {
    color: var(--color-text-light);
    margin-bottom: var(--space-4);
  }

  .news-card time {
    color: var(--color-text-light);
    font-size: var(--size-sm);
  }

  .news-more {
    text-align: center;
    margin-top: var(--space-10);
  }

  .cta-box {
    background: var(--color-bg-alt);
    border-radius: var(--radius-xl);
    padding: var(--space-12);
    text-align: center;
    border: 1px solid var(--color-border-light);
  }

  .cta-box h2 {
    margin-bottom: var(--space-4);
  }

  .cta-box p {
    color: var(--color-text-light);
    font-size: var(--size-lg);
    max-width: 560px;
    margin: 0 auto var(--space-8);
  }

  @media (min-width: 1024px) {
    .hero {
      min-height: 600px;
    }

    .hero-title {
      font-size: 5rem;
    }
  }
</style>
