---
import Layout from '../layouts/Layout.astro';

const funds = [
  {
    name: 'Sjúkrasjóður',
    url: 'https://www.bhm.is/styrkir-og-sjodir/sjukrasjodur',
    desc: 'Styrkir vegna heilsu og forvarna, líkamsræktar, gleraugna og heyrnartækja, auk fæðingarstyrks, sjúkradagpeninga og útfararstyrks.',
  },
  {
    name: 'Orlofssjóður',
    url: 'https://www.bhm.is/styrkir-og-sjodir/orlofssjodur',
    desc: 'Orlofshús og íbúðir til leigu um land allt, ásamt gjafabréfum, gjafakortum og ýmsum afsláttum til félagsfólks.',
  },
  {
    name: 'Starfsmenntunarsjóður',
    url: 'https://www.bhm.is/styrkir-og-sjodir/starfsmenntunarsjodur',
    desc: 'Styrkir til endur- og símenntunar, svo sem vegna námskeiða, ráðstefna og námsferða sem tengjast starfi félagsfólks.',
  },
];
---

<Layout title="Réttindi og kjaramál" description="Sjóðir BHM, kjarasamningar og réttindi félagsmanna FAST." pageKey="pay">
  <div class="page-header">
    <div class="container">
      <h1>Réttindi og kjaramál</h1>
      <p>Upplýsingar um sjóði BHM, kjarasamninga, réttindi og starfskjör akademískra starfsmanna.</p>
    </div>
  </div>

  <div class="page-content">
    <div class="container">
      <div class="prose">
        <h2>Sjóðir BHM</h2>
        <p>
          Félagsfólk FAST á aðild að sjóðum BHM og getur sótt um styrki úr þeim.
          Umsóknir og upplýsingar um réttindastöðu eru á
          <a href="https://minarsidur.bhm.is" target="_blank" rel="noopener">Mínum síðum BHM</a>.
        </p>
      </div>

      <div class="funds-grid">
        {funds.map((fund) => (
          <a class="fund-card" href={fund.url} target="_blank" rel="noopener">
            <h3 class="card-title">{fund.name}</h3>
            <p class="card-text">{fund.desc}</p>
            <span class="fund-link">Nánar á vef BHM &rarr;</span>
          </a>
        ))}
      </div>

      <div class="prose" style="margin-top: var(--space-16);">
        <h2>Kjarasamningar</h2>
        <p>
          FAST hefur ekki enn gildandi kjarasamning við HR. Stjórn félagsins vinnur nú að því verkefni að tryggja félagsmönnum kjarasamning. Sjá nánar í <a href={`${import.meta.env.BASE_URL}frettir/kjarasamningar-stadan`}>frétt</a>.
        </p>
        <p>
          Kjaramál akademískra starfsmanna við HR munu falla undir samninginn sem unnið er að í samstarfi við BHM. Kjarasamningar ná m.a. til launa, vinnutíma, orlofs, veikindaréttar og annarra starfskjara.
        </p>
      </div>

      <div class="rights-grid">
        <div class="card">
          <h3 class="card-title">Laun og launaviðmið</h3>
          <p class="card-text">
            Laun akademískra starfsmanna miðast við launatöflur kjarasamninga.
            Launaviðmið taka mið af starfi, menntun, starfsaldri og öðrum þáttum
            samkvæmt samningum.
          </p>
        </div>
        <div class="card">
          <h3 class="card-title">Orlof</h3>
          <p class="card-text">
            Félagsmenn eiga rétt á orlofi samkvæmt <a href="https://www.althingi.is/lagas/nuna/1987030.html">orlofslögum</a>.
            Nánari upplýsingar um orlofsréttindi og orlofshúsaaðgang í gegnum
            BHM er hægt að nálgast á <a href="https://orlof.bhm.is/">orlofsvef BHM</a>.
          </p>
        </div>
        <div class="card">
          <h3 class="card-title">Veikindaréttur</h3>
          <p class="card-text">
            Réttur til launa í veikindum er tryggður samkvæmt lögum.
            Lengd veikindaréttar fer eftir starfsaldri og ákvæðum gildandi
            ráðningarsamnings.
          </p>
        </div>
        <div class="card">
          <h3 class="card-title">Lífeyrissjóður</h3>
          <p class="card-text">
            Skyldubundið iðgjald er greitt í lífeyrissjóð samkvæmt lögum. Félagsmenn eiga einnig rétt á mótframlagi vinnuveitanda
            í séreignarsjóð.
          </p>
        </div>
        <div class="card">
          <h3 class="card-title">Starfsþróun</h3>
          <p class="card-text">
            Félagsmenn eiga rétt á leyfi og/eða styrk til starfsþróunar, rannsókna
            og endurmenntunar samkvæmt reglum háskólans.
          </p>
        </div>
        <div class="card">
          <h3 class="card-title">Fæðingarorlof</h3>
          <p class="card-text">
            Réttur til fæðingarorlofs er samkvæmt lögum um fæðingar- og foreldraorlof.
            Kjarasamningar geta veitt aukinn rétt umfram lög.
          </p>
        </div>
      </div>

      <div class="prose" style="margin-top: var(--space-16);">
        <h2>Gagnlegir tenglar</h2>
        <ul>
          <li><a href="https://www.bhm.is" target="_blank" rel="noopener">BHM — Bandalag háskólamanna</a></li>
          <li><a href="https://island.is" target="_blank" rel="noopener">Ísland.is — Opinber þjónustugátt</a></li>
        </ul>
      </div>
    </div>
  </div>
</Layout>

<style>
  .rights-grid,
  .funds-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-top: var(--space-10);
  }

  .funds-grid {
    margin-top: var(--space-8);
  }

  .fund-card {
    display: block;
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
  }

  .fund-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--color-border);
    transform: translateY(-2px);
  }

  .fund-card .card-title {
    color: var(--color-primary);
  }

  .fund-card .card-text {
    margin-bottom: 0;
  }

  .fund-link {
    display: inline-block;
    margin-top: var(--space-4);
    color: var(--color-primary-light);
    font-weight: 600;
    font-size: var(--size-sm);
  }

  .fund-card:hover .fund-link {
    color: var(--color-primary);
  }

  @media (min-width: 640px) {
    .rights-grid,
    .funds-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .rights-grid,
    .funds-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
